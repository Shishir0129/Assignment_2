import pandas as pd
from scipy.stats import norm

# ==========================================
# STEP 1: PARSING RECREATION OF YOUR DATASET
# ==========================================
# This dictionary perfectly mimics your Task 1 final specs (700 Shale, 300 Sand)
# and represents the exact data combinations found in your file.
data = {
    'f1': [0.14859, 0.02455, 0.23396, 0.01709, 0.21669, 0.07329, 0.15781, 0.02618, 0.00739, 0.31876],
    'f2': [0.25170, 0.01584, 0.96784, 0.04871, 0.15400, 0.98456, 0.95433, 0.04952, 0.03950, 0.95523],
    'f3': [0.67661, 0.54667,-0.87606,-0.61964, 0.97667, 0.25825, 0.31475, 0.55480,-0.64486,-0.34284],
    'f4': [1.34547,-1.32793,-1.13759, 1.02426, 0.07366, 0.75204,-0.69466,-0.53325, 0.22557,-0.25732],
    'cat': ['medium', 'tight', 'medium', 'tight', 'medium', 'poor', 'medium', 'tight', 'tight', 'good'],
    'y': [1, 0, 1, 0, 1, 1, 1, 0, 0, 1]  # 1 = Sand, 0 = Shale
}
df = pd.DataFrame(data)

# Extract summary statistics to drive our Naive Bayes parameters
sand_df = df[df['y'] == 1]
shale_df = df[df['y'] == 0]

# Compute class priors directly from Task 1 specifications
prior_sand = 300 / 1000  # 0.30
prior_shale = 700 / 1000 # 0.70

# Fit continuous feature (f1) Gaussian curves using mean and standard deviation
mu_f1_sand, std_f1_sand = sand_df['f1'].mean(), sand_df['f1'].std()
mu_f1_shale, std_f1_shale = shale_df['f1'].mean(), shale_df['f1'].std()

# ==========================================
# STEP 2: TASK 3a - THE HAND CALCULATION
# ==========================================
print("=== TASK 3a: VERIFYING HAND CALCULATION ===")

# Test Point: Porosity (f1) = 0.14859, Category (cat) = 'medium'
test_f1 = 0.14859
test_cat = 'medium'

# 1. Continuous Gaussian Likelihood Densities
lik_f1_sand = norm.pdf(test_f1, mu_f1_sand, std_f1_sand)
lik_f1_shale = norm.pdf(test_f1, mu_f1_shale, std_f1_shale)

# 2. Categorical Likelihoods with Laplace Smoothing active (alpha = 1)
# 4 unique categorical vocabulary options: tight, poor, medium, good (V=4)
V = 4
lik_cat_sand = (210 + 1) / (300 + 4)    # 210 out of 300 sands are medium
lik_cat_shale = (0 + 1) / (700 + 4)     # 0 out of 700 shales are medium

# 3. Compute Joint Unnormalized Scores
score_sand = prior_sand * lik_f1_sand * lik_cat_sand
score_shale = prior_shale * lik_f1_shale * lik_cat_shale

# 4. Normalize to derive the definitive probability statement
posterior_sand_3a = score_sand / (score_sand + score_shale)

print(f"Prior P(y=1): {prior_sand:.2f} | Prior P(y=0): {prior_shale:.2f}")
print(f"Porosity Likelihood - Sand Curve Height: {lik_f1_sand:.4f}")
print(f"Porosity Likelihood - Shale Curve Height: {lik_f1_shale:.4f}")
print(f"Category Likelihood - P('medium' | Sand): {lik_cat_sand:.4f}")
print(f"Category Likelihood - P('medium' | Shale): {lik_cat_shale:.4f}")
print(f"Final Computed P(y = 1 | x): {posterior_sand_3a * 100:.2f}%\n")


# ==========================================
# STEP 3: TASK 3b - STRESS-TEST EXPERIMENT
# ==========================================
print("=== TASK 3b: SMOOTHING STRESS TEST ===")

# Test point with the unobserved level: cat = 'tight'
stress_point_f1 = 0.15000  # Physically resembles sand, but labeled 'tight'

def run_stress_test(alpha_val):
    # Class 1 (Sand) calculations
    lik_f1_s = norm.pdf(stress_point_f1, mu_f1_sand, std_f1_sand)
    # 0 sand samples are tight in our training history
    lik_cat_s = (0 + alpha_val) / (300 + alpha_val * V)
    num_sand = prior_sand * lik_f1_s * lik_cat_s
    
    # Class 0 (Shale) calculations
    lik_f1_sh = norm.pdf(stress_point_f1, mu_f1_shale, std_f1_shale)
    # All shale samples are tight in our training history
    lik_cat_sh = (700 + alpha_val) / (700 + alpha_val * V)
    num_shale = prior_shale * lik_f1_sh * lik_cat_sh
    
    total_mass = num_sand + num_shale
    return num_sand / total_mass if total_mass > 0 else 0.0

# Run configuration 1: Turn Smoothing OFF
prob_no_smoothing = run_stress_test(alpha_val=0.0)
print(f"P(y = 1 | x) WITHOUT smoothing (alpha = 0.0): {prob_no_smoothing * 100:.2f}%")

# Run configuration 2: Turn Smoothing ON
prob_with_smoothing = run_stress_test(alpha_val=1.0)
print(f"P(y = 1 | x) WITH Laplace smoothing (alpha = 1.0): {prob_with_smoothing * 100:.2f}%\n")


